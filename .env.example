# Ургийн мод — тохиргооны жишээ. Хуулж .env болгоно: cp .env.example .env
DJANGO_DEBUG=0
SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_ALLOWED_HOSTS=urgiin.example.mn,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://urgiin.example.mn

DB_NAME=urgiin_mod
DB_USER=baysa
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Амьд хүнийг таамаглах насны хязгаар
LIVING_YEARS=110
# Урилгын линк хэдэн хоног хүчинтэй
INVITE_EXPIRY_DAYS=7
SITE_URL=https://urgiin.example.mn

# Amazon SES (anymail). SES-гүй орчинд console backend үлдээнэ.
EMAIL_BACKEND=anymail.backends.amazon_ses.EmailBackend
DEFAULT_FROM_EMAIL=urgiin-mod@integral.mn
AWS_SES_CONFIGURATION_SET=

# AWS — SES болон S3-д нэг IAM хэрэглэгч (зөвхөн энэ бакет + SES илгээх эрх)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# Хоосон бол медиа локал `media/` хавтаст хадгалагдана.
AWS_STORAGE_BUCKET_NAME=
# Presigned URL-ийн хүчинтэй хугацаа (сек)
MEDIA_URL_EXPIRE=300
